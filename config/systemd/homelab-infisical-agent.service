[Unit]
Description=Homelab Infisical Agent
Documentation=https://github.com/jon-robbins/homelab/blob/main/docs/secrets-management.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jon
Group=jon
WorkingDirectory=/srv/homelab
ExecStart=/usr/bin/infisical agent --config /etc/infisical-agent/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
