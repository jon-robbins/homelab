[Unit]
Description=DEPRECATED — use homelab-boot-orchestrator.service
Documentation=file:///homelab/docs/boot-orchestrator.md
After=docker.service
Wants=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
User=jon
Group=jon
Environment=TAILSCALE_BIND_WAIT_SEC=180
# Thin wrapper → orchestrator phases P3–P4 (Tailscale binds only).
ExecStart=/homelab/scripts/ops/start-tailscale-bound-services.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
