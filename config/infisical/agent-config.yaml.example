# Runtime host copy only: install this as /etc/infisical-agent/config.yaml.
# This checked-in example intentionally contains no client credentials, project ID, or secret values.
templates:
  - source-path: ${HOMELAB_ROOT}/config/infisical/templates/CLOUDFLARE_TOKEN.tmpl
    destination-path: ${HOME}/.config/homelab/secrets/CLOUDFLARE_TOKEN
    polling-interval: 60s
    commands:
      - command: ${HOMELAB_ROOT}/scripts/ops/infisical-agent-reload.py --key CLOUDFLARE_TOKEN
  - source-path: ${HOMELAB_ROOT}/config/infisical/templates/TMDB_API_KEY.tmpl
    destination-path: ${HOME}/.config/homelab/secrets/TMDB_API_KEY
    polling-interval: 60s
    commands:
      - command: ${HOMELAB_ROOT}/scripts/ops/infisical-agent-reload.py --key TMDB_API_KEY
  - source-path: ${HOMELAB_ROOT}/config/infisical/templates/SONARR_API_KEY.tmpl
