# Runtime host copy only: install this as /etc/infisical-agent/config.yaml.
# This checked-in example intentionally contains no client credentials, project ID, or secret values.
# Templates are copied from config/infisical/templates to /srv/homelab/infisical/templates (docs/operations.md).
# Containers read /run/homelab-secrets (HOMELAB_SECRET_DIR) and the controller restarts services, so there are no
# reload commands.
templates:
  - source-path: /srv/homelab/infisical/templates/CLOUDFLARE_TOKEN.tmpl
    destination-path: /run/homelab-secrets/CLOUDFLARE_TOKEN
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/TMDB_API_KEY.tmpl
    destination-path: /run/homelab-secrets/TMDB_API_KEY
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/SONARR_API_KEY.tmpl
    destination-path: /run/homelab-secrets/SONARR_API_KEY
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/RADARR_API_KEY.tmpl
    destination-path: /run/homelab-secrets/RADARR_API_KEY
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/PROWLARR_API_KEY.tmpl
    destination-path: /run/homelab-secrets/PROWLARR_API_KEY
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/OVERSEERR_API_KEY.tmpl
    destination-path: /run/homelab-secrets/OVERSEERR_API_KEY
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/QBITTORRENT_USERNAME.tmpl
    destination-path: /run/homelab-secrets/QBITTORRENT_USERNAME
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/QBITTORRENT_PASSWORD.tmpl
    destination-path: /run/homelab-secrets/QBITTORRENT_PASSWORD
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/LIDARR_API_KEY.tmpl
    destination-path: /run/homelab-secrets/LIDARR_API_KEY
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/SLSKD_SLSK_USERNAME.tmpl
    destination-path: /run/homelab-secrets/SLSKD_SLSK_USERNAME
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/SLSKD_SLSK_PASSWORD.tmpl
    destination-path: /run/homelab-secrets/SLSKD_SLSK_PASSWORD
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/SLSKD_WEB_PASSWORD.tmpl
    destination-path: /run/homelab-secrets/SLSKD_WEB_PASSWORD
    polling-interval: 60s
  - source-path: /srv/homelab/infisical/templates/SLSKD_API_KEY.tmpl
    destination-path: /run/homelab-secrets/SLSKD_API_KEY
    polling-interval: 60s
