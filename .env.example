# Generic off-host example values. Site overlays provide deployment-specific values.
PUID=1000
PGID=1000
TZ=UTC
BASE_DOMAIN=example.homelab.local
SITE_HOSTNAME=homelab-example
APP_DATA_DIR=./example-data
MEDIA_DIR=./example-data/media
MEDIA_BIND_IP=127.0.0.1
PEER_BIND_IP=127.0.0.1
MEDIA_HDD_PATH=./example-data/media-hdd
MEDIA_NVME_PATH=./example-data/media-nvme
MEDIA_PLEX_PATH=./example-data/media-plex
HOMELAB_SECRET_DIR=./example-secrets
TAILSCALE_IP=127.0.0.1
QBT_PEER_PORT=51423
# Managed secret values are delivered by Infisical.
CLOUDFLARE_TOKEN=
