#!/usr/bin/env bash
# ExecStartPost of the Infisical agent. Secrets render into tmpfs, so after a boot they do not exist until the agent
# writes them; Docker is ordered after the agent and this holds its start until every rendered file is there.
# It never fails the agent: a missing secret is logged and Docker starts anyway.
set -uo pipefail

CONFIG=${CONFIG:-/etc/infisical-agent/config.yaml}
SECRET_DIR=${SECRET_DIR:-/run/homelab-secrets}
TIMEOUT=${TIMEOUT:-60}

mapfile -t files < <(grep -oE "$SECRET_DIR/[A-Za-z0-9_]+" "$CONFIG" 2>/dev/null | sort -u)
missing=()
for ((i = 0; i < TIMEOUT; i++)); do
  missing=()
  for file in "${files[@]}"; do [[ -s $file ]] || missing+=("${file##*/}"); done
  ((${#missing[@]})) || exit 0
  sleep 1
done
echo "warning: secrets not rendered after ${TIMEOUT}s: ${missing[*]}" >&2
