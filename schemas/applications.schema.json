{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelab.example/schemas/applications.schema.json",
  "title": "ApplicationManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "site_id": { "$ref": "#/$defs/name" },
    "applications": {
      "type": "array",
      "items": { "$ref": "#/$defs/application" }
    }
  },
  "required": ["schema", "applications"],
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "secretName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "imageRef": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[0-9]+)?/[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$" },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "image": { "$ref": "#/$defs/imageRef" },
        "rollback": { "type": "string", "enum": ["automatic", "manual"] },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "secrets": { "type": "array", "items": { "$ref": "#/$defs/secretName" } },
        "health_probe": { "$ref": "#/$defs/name" },
        "semantic_probes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/name" } },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "profile": { "$ref": "#/$defs/name" } },
          "required": ["profile"]
        }
      },
      "required": ["name", "image", "rollback", "depends_on", "secrets", "health_probe", "semantic_probes"]
    }
  }
}
