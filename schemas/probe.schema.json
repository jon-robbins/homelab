{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelab.example/schemas/probe.schema.json",
  "title": "ProbeResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "probe": { "$ref": "#/$defs/name" },
    "target": { "$ref": "#/$defs/name" },
    "release_sequence": { "anyOf": [{ "$ref": "#/$defs/sequence" }, { "type": "null" }] },
    "observed_image_id": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "result": { "type": "string", "enum": ["PASS", "FAIL", "ERROR"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "detail": { "type": "string", "maxLength": 1024 }
  },
  "required": ["schema", "probe", "target", "release_sequence", "observed_image_id", "result", "observed_at", "duration_ms", "detail"],
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
  }
}
