{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelab.example/schemas/provenance.schema.json",
  "title": "BuildProvenance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "repository": { "$ref": "#/$defs/repository" },
    "workflow_ref": { "type": "string", "minLength": 1 },
    "run_id": { "type": "integer", "minimum": 1 },
    "run_attempt": { "type": "integer", "minimum": 1 },
    "source_sha": { "$ref": "#/$defs/gitSha" },
    "image": { "$ref": "#/$defs/name" },
    "manifest_digest": { "$ref": "#/$defs/digest" },
    "built_at": { "type": "string", "format": "date-time" }
  },
  "required": ["schema", "repository", "workflow_ref", "run_id", "run_attempt", "source_sha", "image", "manifest_digest", "built_at"],
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "repository": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}/[a-z][a-z0-9-]{0,62}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
