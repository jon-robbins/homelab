#!/usr/bin/env python3
"""Render a site from the repository root."""

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from scripts.release.render import render


parser = argparse.ArgumentParser()
parser.add_argument("site", type=Path)
parser.add_argument("--plugin", action="append", default=[])
args = parser.parse_args()
try:
    plugins = {}
    for value in args.plugin:
        name, separator, path = value.partition("=")
        if not separator or not name or not path:
            raise ValueError("--plugin must be NAME=DIR")
        plugins[name] = Path(path)
    result = render(Path.cwd(), args.site, plugins)
    print(json.dumps({"app": result.app, "edge": result.edge}, separators=(",", ":")))
except Exception as error:
    print(f"render failed: {error}", file=sys.stderr)
    raise SystemExit(1)
